# Anthropic API key — required only for ClaudeIntakeMapper (real LLM path)
# Leave commented/unset to use MockIntakeMapper (offline/test mode)
# ANTHROPIC_API_KEY=sk-ant-...

# Server port (optional, default 3000)
PORT=3000

# Rate limiting: max requests per client per window (optional)
# RATE_LIMIT_MAX=60
# RATE_LIMIT_WINDOW_SECONDS=60

# Log level (optional): debug | info | warn | error (default: info)
LOG_LEVEL=info
